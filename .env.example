# LLM API 配置（兼容 OpenAI 接口）
DEEPSEEK_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2

# 可选接口鉴权：留空则不启用；配置后 /chat、/chat/stream、/documents 需在请求头携带 X-API-Key
API_AUTH_TOKEN=

# 知识库文件路径（按实际生成的语料名修改）
CHUNKS_PATH=data/processed/sample_code.chunks.jsonl
EMBEDDINGS_PATH=data/processed/sample_code.embeddings.npz

# 向量检索后端：numpy（默认，零外部库）或 chroma（本地持久化，支持增量 upsert 与元数据过滤）
VECTOR_BACKEND=numpy
CHROMA_PERSIST_DIR=data/processed/chroma_db
CHROMA_COLLECTION=building_codes

# 检索与重排模型
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true

# 检索参数（离线评测显示 FUSED_TOP_K=10 与 20 精度持平，CPU 耗时减半）
VECTOR_TOP_K=20
BM25_TOP_K=20
FUSED_TOP_K=10
FINAL_TOP_K=5
RRF_K=60
